# SESSION_SECRET is auto-generated on first run.
# Set it here only if you want to override the auto-generated value.
# SESSION_SECRET=

# Admin credentials are set via first-run setup at /admin
# Legacy support: set these to skip the setup screen
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Email notifications (optional — configure in admin Settings > Email)
# RESEND_API_KEY=
# ADMIN_EMAIL=

# Updates (admin Settings > Update). The mode is auto-detected:
#   - installed from a release zip -> updates come from GitHub Releases
#     (public repo, no credentials needed)
#   - installed via git clone -> updates fetch + hard-reset the branch
# DEPLOY_ENABLED=true
# DEPLOY_MODE=          # force "git" or "release" (default: auto-detect)
# GIT_REPO=             # owner/repo override (default: ajmastf8/show-and-deliver)

# Git mode only:
# DEPLOY_BRANCH=main
# GIT_PAT=              # only needed if the repo is private
# GIT_USERNAME=

# Third-party upload API (optional). When set, requests bearing
# "Authorization: Bearer <API_TOKEN>" are treated as authenticated admin
# calls. Generate with: php -r 'echo bin2hex(random_bytes(32));'
# Leave blank/unset to disable the Bearer path entirely.
# API_TOKEN=

# Delivery: split a client download into parts of this many MB (default 900).
#
# This is NOT a zip limit — it exists because LiteSpeed truncates any
# dynamically generated response past "Max Dynamic Response Body Size" (1 GiB
# by default) and appends an error to the body, leaving the client with a zip
# that won't open. 900 keeps parts safely underneath it.
#
# Set 0 for a single download of any size, but only AFTER raising the server
# limit (LiteSpeed WebAdmin > Tuning, or ask your host). Individual file
# downloads bypass the cap entirely and are unaffected.
# PACKAGE_PART_MB=900

# Hand file serving to the web server instead of streaming through PHP. Frees
# the PHP process immediately, which matters against shared-hosting connection
# limits.
#
#   location  - X-LiteSpeed-Location (recommended where supported)
#   litespeed - X-LiteSpeed-Send-File (legacy; NOT honoured on some hosts)
#   off       - stream through PHP (default, works everywhere)
#
# VERIFY BEFORE ENABLING: a host that ignores the header returns 200 with an
# empty body, so every download silently breaks. Check with:
#   /api/admin/sendfile-test?mode=location   (compare bytes against ?mode=off)
# SENDFILE=off

