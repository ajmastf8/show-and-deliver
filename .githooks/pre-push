#!/bin/sh
# Release freeze guard.
#
# While .release-freeze exists at the repo root, refuse to push `main`. Delete
# the marker deliberately when it is time to release (see .release-freeze).
#
# Install with:  git config core.hooksPath .githooks

marker1="$(git rev-parse --show-toplevel 2>/dev/null)/.release-freeze"
common="$(git rev-parse --git-common-dir 2>/dev/null)"
marker2="$(dirname "$common")/.release-freeze"

if [ -f "$marker1" ] || [ -f "$marker2" ]; then
  blocked=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
      refs/heads/main|refs/heads/master)
        echo "pre-push: refusing to push '$remote_ref' — main is frozen." >&2
        echo "pre-push: see .release-freeze; delete that file to release." >&2
        blocked=1
        ;;
    esac
  done
  if [ "$blocked" = 1 ]; then
    exit 1
  fi
fi
exit 0
