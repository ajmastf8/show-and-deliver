RewriteEngine On
RewriteBase /

# Route pages to HTML files
RewriteRule ^admin/?$ public/admin.html [L]
RewriteRule ^gallery/.+$ public/proofing.html [L]
RewriteRule ^collection/.+$ public/collection.html [L]

# Delivery packages are token-gated and streamed by index.php. Everything else
# under site-data/ is a real file Apache would happily serve directly, so block
# that path explicitly.
RewriteRule ^site-data/packages/ - [F]

# Serve uploads, thumbnails, proxies, captions, and logo from site-data/
RewriteRule ^uploads/(.*)$ site-data/uploads/$1 [L]
RewriteRule ^thumbnails/(.*)$ site-data/thumbnails/$1 [L]
RewriteRule ^proxies/(.*)$ site-data/proxies/$1 [L]
RewriteRule ^captions/(.*)$ site-data/captions/$1 [L]
RewriteRule ^logo/(.*)$ site-data/logo/$1 [L]

# Route /api/* to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/ index.php [L,QSA]

# Everything else not a real file — serve from public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L]

# Default document
DirectoryIndex public/index.html

# Serve WebVTT caption files with the correct MIME type. Safari (and some
# strict browsers) refuse to parse a <track> that arrives as octet-stream.
<IfModule mod_mime.c>
  AddType text/vtt .vtt
</IfModule>

# Upload limits
php_value upload_max_filesize 500M
php_value post_max_size 500M
php_value max_execution_time 300

# HTML must always be fresh so its versioned <script src="...?v=N"> tags
# point at the current JS. Cached HTML keeps referencing old versions.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
